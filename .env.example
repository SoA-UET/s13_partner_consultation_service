# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5013
SECRET_KEY=

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/s13
MONGODB_URI=mongodb://localhost:27017/s13
MONGODB_DB_NAME=s13

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# A10a Queue Names (Receiving from Core)
A10A_REQUESTS_QUEUE=telcenter_a10a_requests
A10A_RESPONSES_QUEUE=telcenter_a10a_responses
A10A_CONSUMER_THREADS=4

# A10b Queue Names (Sending to Core)
A10B_REQUESTS_QUEUE=telcenter_a10b_requests
A10B_RESPONSES_QUEUE=telcenter_a10b_responses

# JWT Authentication
# Base URL of the Identity Service (Core/Partner Employee Identity Service)
# Used to fetch JWKS for JWT verification
IDENTITY_SERVICE_URL=http://localhost:5010

# JWKS Cache TTL in minutes (default: 10)
# How long to cache public keys before refreshing from Identity Service
JWKS_TTL_IN_MINUTES=10

# JWT Clock Skew in seconds (default: 60)
# Allowed time difference for time-based claims (iat, exp)
JWT_CLOCK_SKEW_SECONDS=60
